{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/vercel.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{legacy/**,src/**,node_modules/**,vercel.json,.vercelignore}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/vercel.php" }
  ]
}
